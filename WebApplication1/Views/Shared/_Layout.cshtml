<!DOCTYPE html>
<html lang="en">
<head>
    
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Web Application</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true" />
</head>

<body>

    <!-- TOP NAVIGATION -->
    <header>
        <nav class="top-menu">

            <a class="web-title"asp-controller = "Johnry" asp-action = "Index">Web Application</a>

            <div class="nav-links">
                <a asp-controller="Johnry"asp-action="Index">Menu</a>
                <a asp-controller="Johnry"asp-action="Profile">Profile</a>
                <a asp-controller="Johnry"asp-action="Portfolio">Portfolio</a>
            </div>

        </nav>
    </header>


    <!-- PAGE CONTENT -->
    <main>
        @RenderBody()
    </main>


    <!-- BOTTOM FOOTER -->
    <footer class="bottom-footer">
        <p>© 2026 - Web Application</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>