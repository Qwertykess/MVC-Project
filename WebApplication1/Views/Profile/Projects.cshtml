@model IEnumerable<WebApplication1.Models.ProjectsModel>;
@{
    ViewData["Title"] = "Projects Tab";
}

<div class="text-center coldir">
    <div class="span-box pf-style"><h1>Project Profolio</h1></div>
    <table class="pf-style">
        <tr>
            <th class="col-1">No.</th>
            <th class="col-2">Title</th>
            <th class="col-3">Repository Link</th>
            <th class="col-4">Last Updated</th>
        </tr>
        @foreach (var proj in Model)
        {
            <tr>
                <td>@proj.ProjID</td>
                <td>@proj.ProjName</td>
                <td><a href="@proj.RepoLink">@proj.RepoLink</a></td>
                <td>@proj.DateUpdated</td>
            </tr>
        }
    </table>
</div>
